<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security policy: block all cleartext HTTP traffic.
  All API calls use HTTPS (skill sync backend).
  The LLM inference runs 100% on-device — no network traffic.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
